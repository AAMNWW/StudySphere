// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

/// A student's chosen full-app color theme — background, cards, buttons and
/// the active nav highlight, not just one accent (src/app/globals.css's
/// `[data-palette]` blocks). GRAPHITE is the app's original grayscale look
/// and needs no override — every other value is applied via a
/// `data-palette` attribute set in src/app/layout.tsx, and each has its own
/// light- and dark-mode colors so it still looks intentional either way.
enum ColorPalette {
  GRAPHITE
  HELLO_KITTY
  SPIDER_MAN
  GALAXY
  OCEAN
  FOREST
}

/// A student. Owns every course (and, through courses, every note and
/// assignment) they create.
model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  /// bcrypt hash, never the plaintext password.
  password       String
  /// STUDENT for every account except the one that runs the admin panel
  /// (src/app/admin). There's no self-serve promotion path — the one admin
  /// is bootstrapped by the add_user_role_and_prefs migration.
  role           UserRole        @default(STUDENT)
  /// Whether this student gets the deadline-reminder digest email (see
  /// src/app/api/cron/deadline-reminders). The in-app notification created
  /// alongside it is unaffected by this — it only controls the email.
  emailRemindersEnabled Boolean  @default(true)
  /// Customized from /settings; read server-side in the root layout and
  /// applied as a `data-palette` attribute so there's no flash of the
  /// default colors on first paint.
  colorPalette   ColorPalette    @default(GRAPHITE)
  courses        Course[]
  quizAnswerLogs QuizAnswerLog[]
  notifications  Notification[]
  /// Consecutive days (including today) the dashboard has been visited.
  /// Updated in src/lib/streak.ts whenever the dashboard loads.
  currentStreak  Int             @default(0)
  longestStreak  Int             @default(0)
  /// UTC calendar date of the last dashboard visit that counted toward the
  /// streak. Null until the first visit.
  lastVisitAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// A subject the student is studying. Notes, assignments and uploaded
/// documents all hang off this model.
model Course {
  id             String          @id @default(cuid())
  title          String
  description    String?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes          Note[]
  assignments    Assignment[]
  documents      Document[]
  chatThreads    ChatThread[]
  flashcardSets  FlashcardSet[]
  quizzes        Quiz[]
  topics         Topic[]
  quizAnswerLogs QuizAnswerLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

/// A piece of writing a student keeps against a course: a lecture summary,
/// a reading response, a list of things to revisit before an exam.
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

/// Something with a deadline the student owes for a course: a problem set,
/// an essay, a reading due before the next class.
model Assignment {
  id             String    @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean   @default(false)
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Set once a deadline-reminder email has gone out for this assignment,
  /// so the daily cron (src/app/api/cron/deadline-reminders) never sends a
  /// duplicate. Not cleared if the due date later moves.
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([courseId])
}

/// A file (PDF, DOCX or PPTX) a student has uploaded against a course. The
/// bytes live on local disk (see src/lib/uploads.ts); this row is the
/// pointer plus enough metadata to render and authorize a download.
model Document {
  id            String          @id @default(cuid())
  /// The name as uploaded, shown in the UI and used for the download.
  fileName      String
  /// The on-disk filename (a random id + extension) — never derived from
  /// user input, so it can't be used for path traversal or collide.
  storedName    String
  /// Public URL when the file lives in Vercel Blob storage; null when it
  /// lives on local disk (see src/lib/uploads.ts, which branches on this).
  storageUrl    String?
  mimeType      String
  sizeBytes     Int
  /// AI-generated summary of the file's contents, produced on demand via
  /// the Gemini API (see src/lib/ai/summarize-document.ts). Null until a
  /// student requests one.
  summary       String?
  /// Set when the most recent summary attempt failed, so the UI can show
  /// why and offer a retry. Cleared on the next successful attempt.
  summaryError  String?
  courseId      String
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chatThreads   ChatThread[]
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]
  chunks        DocumentChunk[]
  /// Set once this document has been chunked and embedded for RAG search
  /// (src/lib/rag/). Null means "ask across my whole course" chat won't
  /// find anything in it yet.
  indexedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([courseId])
}

/// A conversation with the AI: general course chat, or grounded in one or
/// more documents and/or a topic focus.
model ChatThread {
  id                String        @id @default(cuid())
  title             String
  courseId          String
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Legacy FK, set only for the original single-document "PDF chat"
  /// threads (kept so deleting that document cascades the thread away).
  /// New threads leave this null and record sources via
  /// sourceDocumentIds instead, since they may ground on 0-5 documents.
  documentId        String?
  document          Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// IDs of every document grounding this thread, in selection order.
  sourceDocumentIds Json          @default("[]")
  /// Optional free-text focus hint, e.g. "the French Revolution".
  topic             String?
  /// "Ask across my whole course" mode: answers are grounded in
  /// RAG-retrieved chunks (src/lib/rag/) instead of sourceDocumentIds, and
  /// generated by Grok instead of Gemini.
  ragMode           Boolean       @default(false)
  messages          ChatMessage[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([courseId])
  @@index([documentId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "user" or "assistant".
  role      String
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId])
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
  PRO
  MASTER
}

/// An AI-generated multiple-choice quiz. Scoped to one legacy document
/// (documentId set) or to a course-wide / topic-focused set of documents
/// chosen at generation time (documentId null, sourceDocumentIds set).
/// Regenerating never deletes prior quizzes — they accumulate as history.
model Quiz {
  id                String          @id @default(cuid())
  title             String
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Legacy FK, set only for the original single-document generation path
  /// (kept so deleting that document cascades its quizzes away).
  documentId        String?
  document          Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// IDs of every document used as generation source, in selection order.
  sourceDocumentIds Json            @default("[]")
  /// Optional free-text focus hint, independent of the Topic model.
  topic             String?
  difficulty        QuizDifficulty  @default(MEDIUM)
  questions         QuizQuestion[]
  answerLogs        QuizAnswerLog[]
  createdAt         DateTime        @default(now())

  @@index([courseId])
  @@index([documentId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  /// The answer choices, in display order.
  options       Json
  correctIndex  Int
  /// The index the student picked; null until they answer.
  selectedIndex Int?
  order         Int

  @@index([quizId])
}

/// An AI-generated set of flashcards. Same multi-document/topic shape as
/// Quiz, minus difficulty (flashcards have no difficulty tiers).
model FlashcardSet {
  id                String      @id @default(cuid())
  title             String
  courseId          String
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  documentId        String?
  document          Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceDocumentIds Json        @default("[]")
  topic             String?
  cards             Flashcard[]
  createdAt         DateTime    @default(now())

  @@index([courseId])
  @@index([documentId])
}

model Flashcard {
  id    String       @id @default(cuid())
  setId String
  set   FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  front String
  back  String
  order Int

  @@index([setId])
}

enum TopicSource {
  AI
  MANUAL
}

/// A weekly-roadmap entry for a course: what to study and when. Either
/// proposed by Gemini from the course's documents (source = AI) or typed in
/// directly by the student (source = MANUAL).
model Topic {
  id          String      @id @default(cuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  weekNumber  Int?
  source      TopicSource @default(MANUAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([courseId])
}

/// A durable record of one quiz-answer submission, written at
/// answer-submission time (not generation time) so it survives quiz
/// regeneration/deletion — the source of per-course wrong-answer history.
model QuizAnswerLog {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Nulled (not cascade-deleted) when the originating Quiz is later
  /// deleted or regenerated — the point of this table is to outlive it.
  quizId        String?
  quiz          Quiz?          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  topic         String?
  difficulty    QuizDifficulty
  question      String
  options       Json
  correctIndex  Int
  selectedIndex Int
  isCorrect     Boolean
  createdAt     DateTime       @default(now())

  @@index([userId, courseId])
  @@index([courseId, isCorrect])
}

/// One chunk of a document's extracted text, embedded for retrieval
/// (src/lib/rag/). The embedding column is Unsupported because Prisma's
/// schema language has no native vector type — it's written/read via raw
/// SQL, while every other field goes through the normal Prisma Client.
model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Denormalized from Document so retrieval can filter by course in the
  /// same query as the similarity search, without a join.
  courseId   String
  chunkIndex Int
  content    String
  pageNumber Int?
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([courseId])
}

enum NotificationType {
  ASSIGNMENT_DUE_SOON
  STUDY_PLAN_READY
}

/// An in-app notification for one student, e.g. "assignment due soon" (from
/// the deadline-reminder cron) or "study plan ready" (from the LangGraph
/// planner agent). `link` is where clicking it should take the student.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  link      String
  /// Null until the student opens/dismisses it.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}
