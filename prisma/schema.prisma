// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A student. Owns every course (and, through courses, every note and
/// assignment) they create.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  /// bcrypt hash, never the plaintext password.
  password  String
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A subject the student is studying. Notes, assignments and uploaded
/// documents will all hang off this model in later milestones.
model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

/// A piece of writing a student keeps against a course: a lecture summary,
/// a reading response, a list of things to revisit before an exam.
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

/// Something with a deadline the student owes for a course: a problem set,
/// an essay, a reading due before the next class.
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId])
}
