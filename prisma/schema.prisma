// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A student. Owns every course (and, through courses, every note and
/// assignment) they create.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  /// bcrypt hash, never the plaintext password.
  password  String
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A subject the student is studying. Notes, assignments and uploaded
/// documents all hang off this model.
model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  assignments Assignment[]
  documents   Document[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

/// A piece of writing a student keeps against a course: a lecture summary,
/// a reading response, a list of things to revisit before an exam.
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

/// Something with a deadline the student owes for a course: a problem set,
/// an essay, a reading due before the next class.
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId])
}

/// A file (PDF, DOCX or PPTX) a student has uploaded against a course. The
/// bytes live on local disk (see src/lib/uploads.ts); this row is the
/// pointer plus enough metadata to render and authorize a download.
model Document {
  id           String   @id @default(cuid())
  /// The name as uploaded, shown in the UI and used for the download.
  fileName     String
  /// The on-disk filename (a random id + extension) — never derived from
  /// user input, so it can't be used for path traversal or collide.
  storedName   String
  mimeType     String
  sizeBytes    Int
  /// AI-generated summary of the file's contents, produced on demand via
  /// the Gemini API (see src/lib/ai/summarize-document.ts). Null until a
  /// student requests one.
  summary      String?
  /// Set when the most recent summary attempt failed, so the UI can show
  /// why and offer a retry. Cleared on the next successful attempt.
  summaryError String?
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([courseId])
}
