// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A student. Owns every course (and, through courses, every note and
/// assignment) they create.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  /// bcrypt hash, never the plaintext password.
  password  String
  courses   Course[]
  /// Consecutive days (including today) the dashboard has been visited.
  /// Updated in src/lib/streak.ts whenever the dashboard loads.
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  /// UTC calendar date of the last dashboard visit that counted toward the
  /// streak. Null until the first visit.
  lastVisitAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A subject the student is studying. Notes, assignments and uploaded
/// documents all hang off this model.
model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  assignments Assignment[]
  documents   Document[]
  chatThreads   ChatThread[]
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

/// A piece of writing a student keeps against a course: a lecture summary,
/// a reading response, a list of things to revisit before an exam.
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

/// Something with a deadline the student owes for a course: a problem set,
/// an essay, a reading due before the next class.
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId])
}

/// A file (PDF, DOCX or PPTX) a student has uploaded against a course. The
/// bytes live on local disk (see src/lib/uploads.ts); this row is the
/// pointer plus enough metadata to render and authorize a download.
model Document {
  id           String   @id @default(cuid())
  /// The name as uploaded, shown in the UI and used for the download.
  fileName     String
  /// The on-disk filename (a random id + extension) — never derived from
  /// user input, so it can't be used for path traversal or collide.
  storedName   String
  mimeType     String
  sizeBytes    Int
  /// AI-generated summary of the file's contents, produced on demand via
  /// the Gemini API (see src/lib/ai/summarize-document.ts). Null until a
  /// student requests one.
  summary      String?
  /// Set when the most recent summary attempt failed, so the UI can show
  /// why and offer a retry. Cleared on the next successful attempt.
  summaryError String?
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chatThreads   ChatThread[]
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]
  createdAt    DateTime @default(now())

  @@index([courseId])
}

/// A conversation with the AI, either scoped to one document ("PDF chat") or
/// general to a course with no document ("AI tutor").
model ChatThread {
  id         String        @id @default(cuid())
  title      String
  courseId   String
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Null for a general AI tutor thread; set for a thread scoped to one
  /// document's content ("PDF chat").
  documentId String?
  document   Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([courseId])
  @@index([documentId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "user" or "assistant".
  role      String
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId])
}

/// An AI-generated multiple-choice quiz over a document's content.
model Quiz {
  id         String         @id @default(cuid())
  title      String
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions  QuizQuestion[]
  createdAt  DateTime       @default(now())

  @@index([courseId])
  @@index([documentId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  /// The answer choices, in display order.
  options       Json
  correctIndex  Int
  /// The index the student picked; null until they answer.
  selectedIndex Int?
  order         Int

  @@index([quizId])
}

/// An AI-generated set of flashcards over a document's content.
model FlashcardSet {
  id         String      @id @default(cuid())
  title      String
  courseId   String
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  cards      Flashcard[]
  createdAt  DateTime    @default(now())

  @@index([courseId])
  @@index([documentId])
}

model Flashcard {
  id    String       @id @default(cuid())
  setId String
  set   FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  front String
  back  String
  order Int

  @@index([setId])
}
