# Copy this file to .env and fill in real values.
# Every environment variable the app needs must be documented here.

# PostgreSQL connection string.
# Local development uses the container defined in docker-compose.yml.
DATABASE_URL="postgresql://user:password@localhost:5432/studysphere?schema=public"

# Signs and encrypts Auth.js session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Gemini API key used for AI document summaries (see
# src/lib/ai/summarize-document.ts). Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional locally. When set, document uploads are stored in Vercel Blob
# instead of local disk (see src/lib/uploads.ts) — required in production,
# since Vercel's filesystem is ephemeral. Provisioned automatically when a
# Blob store is attached to the Vercel project.
BLOB_READ_WRITE_TOKEN=""

# One OAuth client, shared by both Google features: "Continue with Google"
# sign-in (src/auth.ts) and "Connect Google Calendar" from /settings
# (src/lib/google-calendar.ts). Leave these blank and both features hide
# themselves rather than half-working — a blank client id otherwise reaches
# Google as `client_id=` and dead-ends on "Error 401: invalid_client".
#
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add all four
# authorized redirect URIs — one pair per flow, and Google rejects any
# redirect URI not listed here exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
#   http://localhost:3000/api/integrations/google-calendar/callback
#   https://<your-production-domain>/api/integrations/google-calendar/callback
#
# Calendar sync additionally needs the Google Calendar API enabled on the
# same Cloud project (https://console.cloud.google.com/apis/library/calendar-json.googleapis.com),
# and — while the OAuth consent screen is still in "Testing" — every account
# that will connect a calendar listed under Audience > Test users.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sends assignment deadline-reminder emails via Gmail SMTP (see
# src/lib/email/). Requires 2-Step Verification enabled on the Google
# account, then an App Password generated at
# https://myaccount.google.com/apppasswords
EMAIL_USER=""
EMAIL_PASSWORD=""

# Authorizes the deadline-reminder cron route (src/app/api/cron/deadline-reminders)
# so only Vercel's scheduler can trigger it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=""
